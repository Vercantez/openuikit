// The minimal CoreFoundation surface UserDefaults needs, as a clang module the
// guest build can import WITHOUT pulling Apple's CoreFoundation Swift overlay.
// Named distinctly from "CoreFoundation" on purpose: two modules claiming that
// name is the ambiguity this exists to avoid.
module CFPreferencesMinimal [system] {
    header "../CFPreferencesMinimal.h"
    export *
}

// The libc surface the guest half needs, for the same reason and by the same
// rule: declare what we use rather than import a module we do not ship.
module UDPlatformMinimal [system] {
    header "../UDPlatformMinimal.h"
    export *
}
