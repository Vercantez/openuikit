{
  "commands": [
    "set -eu",
    "support=/opt/openuikit/core-cold/support-fixes/378718c-20260901/support",
    "output=/opt/openuikit/core-cold/packages/core-guest-r22-378718c-20260901",
    "audit=/var/lib/openuikit/audits/core-cold-r22-20260901/core-package-verify-378718c",
    "test \"$(git -C $support rev-parse HEAD)\" = 378718c07ea88dc7358b7fe67cb3c51b023c601d",
    "test \"$(git -C $support rev-parse HEAD^{tree})\" = b106bab65394e910d01a0d4b7a29985396fb49df",
    "test -z \"$(git -C $support status --porcelain=v1 --untracked-files=all)\"",
    "test -d $output",
    "test ! -L $output",
    "test -f $output/attestation/core-package.json",
    "test -f $output/lib/libSwiftUI.dylib",
    "test -f $output/lib/libUIKit.dylib",
    "test -f $output/lib/libFoundation.dylib",
    "test -f $output/lib/libDispatch.dylib",
    "test -f $output/modules/SwiftUI.swiftmodule",
    "test -f $output/modules/UIKit.swiftmodule",
    "test -f $output/modules/DeveloperToolsSupport.swiftmodule",
    "test ! -e $audit",
    "test ! -L $audit",
    "test -z \"$(docker ps -q)\"",
    "install -d -m 0755 $audit",
    "python3 -B $support/full/xcodeplan/core_guest_package.py $output --emit-summary | tee $audit/validator-summary.txt",
    "python3 -B -c 'import json,sys; m=json.load(open(sys.argv[1], encoding=\"utf-8\")); assert m.get(\"preview\") is None; print(\"preview\\tdisabled\"); print(\"artifacts\\t%d\" % len(m[\"artifacts\"])); print(\"target\\t%s\" % m[\"target\"][\"triple\"])' $output/attestation/core-package.json > $audit/manifest-summary.tsv",
    "module_count=$(find $output/modules -maxdepth 1 -mindepth 1 -name '*.swiftmodule' ! -type l -print | wc -l)",
    "dylib_count=$(find $output/lib -maxdepth 1 -mindepth 1 -type f -name '*.dylib' -print | wc -l)",
    "artifact_count=$(python3 -B -c 'import json,sys; print(len(json.load(open(sys.argv[1], encoding=\"utf-8\"))[\"artifacts\"]))' $output/attestation/core-package.json)",
    "printf 'modules\\t%s\\ndylibs\\t%s\\nartifacts\\t%s\\n' $module_count $dylib_count $artifact_count | tee $audit/counts.tsv",
    "sha256sum $output/attestation/core-package.json $output/lib/libSwiftUI.dylib $output/lib/libUIKit.dylib $output/lib/libFoundation.dylib $output/lib/libDispatch.dylib > $audit/key-hashes.txt",
    "file $output/lib/libSwiftUI.dylib $output/lib/libUIKit.dylib $output/lib/libFoundation.dylib $output/lib/libDispatch.dylib | tee $audit/key-file-types.txt",
    "test -z \"$(docker ps -q)\"",
    "printf 'EC2_CORE_PACKAGE_EXTERNAL_VERIFY_OK output=%s modules=%s dylibs=%s artifacts=%s\\n' $output $module_count $dylib_count $artifact_count"
  ],
  "executionTimeout": ["3600"]
}
