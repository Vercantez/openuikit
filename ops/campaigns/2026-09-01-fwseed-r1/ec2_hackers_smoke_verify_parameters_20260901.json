{
  "commands": [
    "set -eu",
    "support=/opt/openuikit/core-cold/support-fixes/44bd5af-20260901/support",
    "inputs=/opt/openuikit/core-cold/app-inputs/hackers-83016de-20260901",
    "output=/opt/openuikit/core-cold/app-smokes/hackers-r23-44bd5af-20260901",
    "smoke_audit=/var/lib/openuikit/audits/core-cold-r22-20260901/hackers-smoke-44bd5af",
    "audit=/var/lib/openuikit/audits/core-cold-r22-20260901/hackers-smoke-44bd5af-external",
    "test \"$(git -C $support rev-parse HEAD)\" = 44bd5af26b94cbddff553ad52409adb57c29930a",
    "test \"$(git -C $support rev-parse HEAD^{tree})\" = 4e121e6afc80ed3885f2d5df5905a2c7221e6f75",
    "test -z \"$(git -C $support status --porcelain=v1 --untracked-files=all)\"",
    "test \"$(git -C $inputs/app rev-parse HEAD)\" = 83016de256ef5418f76ec53182d25e302a519234",
    "test \"$(git -C $inputs/app rev-parse HEAD^{tree})\" = 7155d4ac47b2ecde906d0f438033ad18c6182143",
    "test -z \"$(git -C $inputs/app status --porcelain=v1 --untracked-files=all)\"",
    "test -d $output",
    "test ! -L $output",
    "test -f $output/Hackers2.app/Contents/MacOS/Hackers2",
    "test -f $output/application-build-plan.json",
    "test -f $output/driver.log",
    "test -f $output/runtime.log",
    "test -f $smoke_audit/smoke-output-hashes.txt",
    "test ! -e $audit",
    "test ! -L $audit",
    "test -z \"$(docker ps -aq)\"",
    "install -d -m 0755 $audit",
    "sha256sum -c $smoke_audit/smoke-output-hashes.txt | tee $audit/smoke-output-rehash.txt",
    "grep -Fx 'PORTABLE_APPLICATION_GUEST_OK' $output/driver.log >/dev/null",
    "grep -Fx 'PORTABLE_UIKIT_HOST_ACTIVE windows=1' $output/runtime.log >/dev/null",
    "grep -Fx 'PORTABLE_UIKIT_HOST_LOOP_OK turns=3 paced=true' $output/runtime.log >/dev/null",
    "grep -F 'LOCAL_PACKAGE_BUILD_CONTRACT_VERIFIED targets=12' $smoke_audit/host-wrapper.log >/dev/null",
    "grep -F 'APPLICATION_BUILD_PLAN_OK sources=13 compiler_inputs=0 resource_files=10' $smoke_audit/host-wrapper.log >/dev/null",
    "file $output/Hackers2.app/Contents/MacOS/Hackers2 | tee $audit/executable-file-type.txt",
    "sha256sum $output/Hackers2.app/Contents/MacOS/Hackers2 $output/application-build-plan.json $output/driver.log $output/runtime.log > $audit/key-output-hashes.txt",
    "printf 'temporary-run-roots\\t' > $audit/state.tsv",
    "find /opt/openuikit/core-cold/app-smokes -maxdepth 1 -mindepth 1 -name '.portable-application-run.*' -print | wc -l >> $audit/state.tsv",
    "printf 'containers\\t0\\n' >> $audit/state.tsv",
    "test -z \"$(docker ps -aq)\"",
    "echo EC2_HACKERS_EXTERNAL_SMOKE_VERIFY_OK"
  ],
  "executionTimeout": ["900"]
}
