+            if (!pdf_array_numbers(file, m, 6, matrix)) return false;
+        const PDFValue *form_resources = pdf_resolve(file, pdf_dict_get(dictionary, "Resources"));
+        if (!form_resources) form_resources = resources;
+        if (!form_resources || form_resources->kind != PDFValue::Dictionary) return false;
+        Path saved_path = destination->path;
+        destination->path.clear();
+        QZContextSaveGState(destination);
+        QZContextConcatCTM(destination, QZAffineTransformMake(matrix[0], matrix[1], matrix[2],
+                                                               matrix[3], matrix[4], matrix[5]));
+        QZContextClipToRect(destination, bbox);
+        PDFReplay child(file, destination, form_resources, depth + 1);
+        child.state = initial_state;
+        bool ok = child.run(*content) && child.balanced();
+        QZContextRestoreGState(destination);
+        destination->path = std::move(saved_path);
+        return ok;
+    }
+
+    bool apply_soft_mask(const PDFValue *mask) {
+        if (!mask || mask->kind != PDFValue::Dictionary || depth >= 16) return false;
+        static const std::unordered_set<std::string> supported = {
+            "Type", "S", "G", "TR"
+        };
+        for (const auto &item : mask->dictionary)
+            if (!supported.count(item.first)) return false;
+        if (const PDFValue *type = pdf_dict_get(mask, "Type")) {
+            std::string name;
+            if (!pdf_name(file, type, &name) || name != "Mask") return false;
+        }
+        std::string subtype;
+        if (!pdf_name(file, pdf_dict_get(mask, "S"), &subtype) ||
+            (subtype != "Alpha" && subtype != "Luminosity")) return false;
+        bool luminosity = subtype == "Luminosity";
+        const PDFValue *group = pdf_dict_get(mask, "G");
+        if (!group || group->kind != PDFValue::Ref) return false;
+
+        bool identity_transfer = true;
+        std::vector<CalcItem> transfer;
+        if (const PDFValue *tr = pdf_dict_get(mask, "TR")) {
+            const PDFValue *resolved = pdf_resolve(file, tr);
+            if (resolved && resolved->kind == PDFValue::Name && resolved->text == "Identity") {
+                identity_transfer = true;
+            } else {
+                identity_transfer = false;
+                if (!calculator_function(tr, 1, &transfer)) return false;
+            }
+        }
+
+        QZContextRef mask_context = QZBitmapContextCreate(
+            nullptr, (size_t)ctx->width, (size_t)ctx->height, 8, ctx->bpr,
+            kQZImageAlphaPremultipliedLast);
+        if (!mask_context) return false;
+        /* A PDF soft-mask group is painted in the current user space but into
+         * an isolated transparent buffer.  Carry the device transform and
+         * current clip across; the mask's Form matrix/BBox are applied by the
+         * same checked Form renderer used by Do. */
+        mask_context->gs = ctx->gs;
+        bool ok = draw_form_object(group->reference, mask_context, state);
+        if (ok) {
+            const uint8_t *pixels = mask_context->pixels;
+            size_t count = (size_t)ctx->width * (size_t)ctx->height;
+            if (ctx->gs.clip.size() != count) ok = false;
+            for (size_t i = 0; ok && i < count; i++) {
+                size_t pixel = (i / (size_t)ctx->width) * mask_context->bpr +
+                               (i % (size_t)ctx->width) * 4;
+                /* The buffer is premultiplied over a transparent-black
+                 * backdrop.  For a luminosity mask that makes the weighted
+                 * premultiplied components exactly the specified group
+                 * luminosity, including coverage/alpha. */
+                double alpha = luminosity
+                    ? (0.30 * pixels[pixel] + 0.59 * pixels[pixel + 1] +
+                       0.11 * pixels[pixel + 2]) / 255.0
+                    : pixels[pixel + 3] / 255.0;
+                if (!identity_transfer) {
+                    double mapped = 0;
+                    if (!calc_evaluate(transfer, alpha, 1, &mapped)) { ok = false; break; }
+                    alpha = clampd(mapped, 0, 1);
+                }
+                ctx->gs.clip[i] = mul255(ctx->gs.clip[i], u8_from_unit(alpha));
+            }
+        }
+        QZContextRelease(mask_context);
+        return ok;
+    }
+
+    bool draw_xobject(const std::string &name) {
+        if (depth >= 16) return false;
+        const PDFValue *entry = pdf_resource(file, resources, "XObject", name);
+        if (!entry || entry->kind != PDFValue::Ref) return false;
+        int object_number = entry->reference;
+        const PDFValue *dictionary = pdf_object_dictionary(file, object_number);
+        std::string subtype;
+        if (!dictionary || !pdf_name(file, pdf_dict_get(dictionary, "Subtype"), &subtype)) return false;
+        if (subtype == "Image") {
+            QZImageRef image = image_object(object_number);
+            if (!image) return false;
+            QZContextSetAlpha(ctx, state.fill_alpha);
+            QZContextDrawImage(ctx, QZRectMake(0, 0, 1, 1), image);
+            return true;
+        }
+        return draw_form_object(object_number, ctx, state);
+    }
+
+    bool paint_pattern(bool even_odd) {
+        if (state.fill_pattern.empty()) return false;
+        const PDFValue *entry = pdf_resource(file, resources, "Pattern", state.fill_pattern);
+        const PDFValue *pattern = pdf_resolve(file, entry);
+        int pattern_type = 0, shading_type = 0;
+        if (!pattern || !pdf_int(file, pdf_dict_get(pattern, "PatternType"), &pattern_type) ||
+            pattern_type != 2) return false;
+        static const std::unordered_set<std::string> pattern_keys = {
+            "Type", "PatternType", "Shading", "Matrix"
+        };
+        for (const auto &item : pattern->dictionary)
+            if (!pattern_keys.count(item.first)) return false;
+        if (const PDFValue *type = pdf_dict_get(pattern, "Type")) {
+            std::string type_name;
+            if (!pdf_name(file, type, &type_name) || type_name != "Pattern") return false;
+        }
+        const PDFValue *shading = pdf_resolve(file, pdf_dict_get(pattern, "Shading"));
+        if (!shading || !pdf_int(file, pdf_dict_get(shading, "ShadingType"), &shading_type) ||
+            (shading_type != 2 && shading_type != 3)) return false;
+        static const std::unordered_set<std::string> shading_keys = {
+            "ShadingType", "ColorSpace", "Coords", "Domain", "Function",
+            "Extend", "AntiAlias"
+        };
+        for (const auto &item : shading->dictionary)
+            if (!shading_keys.count(item.first)) return false;
+        double shading_domain[2] = {0, 0};
+        if (const PDFValue *domain = pdf_dict_get(shading, "Domain"))
+            if (!pdf_array_numbers(file, domain, 2, shading_domain) ||
+                shading_domain[0] != 0 || shading_domain[1] != 1) return false;
+        if (const PDFValue *aa = pdf_resolve(file, pdf_dict_get(shading, "AntiAlias")))
+            if (aa->kind != PDFValue::Boolean) return false;
+        std::string color_space;
+        if (!pdf_name(file, pdf_dict_get(shading, "ColorSpace"), &color_space) ||
+            (color_space != "DeviceRGB" && color_space != "DeviceGray")) return false;
+        size_t source_outputs = color_space == "DeviceGray" ? 1 : 3;
+        const PDFValue *function_ref = pdf_dict_get(shading, "Function");
+        std::vector<CalcItem> program;
+        if (!calculator_function(function_ref, source_outputs, &program)) return false;
+        double matrix[6] = {1, 0, 0, 1, 0, 0};
+        if (const PDFValue *m = pdf_dict_get(pattern, "Matrix"))
+            if (!pdf_array_numbers(file, m, 6, matrix)) return false;
+        const PDFValue *extend = pdf_resolve(file, pdf_dict_get(shading, "Extend"));
+        bool extend0 = false, extend1 = false;
+        if (extend) {
+            if (extend->kind != PDFValue::Array || extend->array.size() != 2 ||
+                extend->array[0].kind != PDFValue::Boolean ||
+                extend->array[1].kind != PDFValue::Boolean) return false;
+            extend0 = extend->array[0].boolean;
+            extend1 = extend->array[1].boolean;
+        }
+        ShadingEvalInfo info{&program, source_outputs};
+        QZFloat domain[2] = {0, 1};
+        QZFloat range[6] = {0, 1, 0, 1, 0, 1};
+        QZFunctionRef function = QZFunctionCreate(&info, 1, domain, 3, range,
+                                                   pdf_shading_evaluate);
+        if (!function) return false;
+        QZShadingRef qz_shading = nullptr;
+        const PDFValue *coords = pdf_dict_get(shading, "Coords");
+        if (shading_type == 2) {
+            double c[4];
+            if (pdf_array_numbers(file, coords, 4, c))
+                qz_shading = QZShadingCreateAxial(QZPointMake(c[0], c[1]),
+                                                   QZPointMake(c[2], c[3]), function,
+                                                   extend0, extend1);
+        } else {
+            double c[6];
+            if (pdf_array_numbers(file, coords, 6, c))
+                qz_shading = QZShadingCreateRadial(QZPointMake(c[0], c[1]), c[2],
+                                                    QZPointMake(c[3], c[4]), c[5],
+                                                    function, extend0, extend1);
+        }
+        QZFunctionRelease(function);
+        if (!qz_shading) return false;
+        QZContextSaveGState(ctx);
+        QZContextSetAlpha(ctx, state.fill_alpha);
+        if (even_odd) QZContextEOClip(ctx); else QZContextClip(ctx);
+        QZContextConcatCTM(ctx, QZAffineTransformMake(matrix[0], matrix[1], matrix[2],
+                                                       matrix[3], matrix[4], matrix[5]));
+        QZContextDrawShading(ctx, qz_shading);
+        QZContextRestoreGState(ctx);
+        QZShadingRelease(qz_shading);
+        return true;
+    }
+
+    bool paint(QZPathDrawingMode mode, bool close_path) {
+        if (pending_clip) return false; /* corpus clips terminate with n */
+        if (close_path) QZContextClosePath(ctx);
+        bool fill = mode == kQZPathFill || mode == kQZPathEOFill ||
+                    mode == kQZPathFillStroke || mode == kQZPathEOFillStroke;
+        bool stroke = mode == kQZPathStroke || mode == kQZPathFillStroke ||
+                      mode == kQZPathEOFillStroke;
+        if (stroke && state.stroke_adjustment) return false;
+        if (fill && state.fill_space == PDFColorSpace::Pattern) {
+            if (stroke) return false;
+            return paint_pattern(mode == kQZPathEOFill);
+        }
+        if (fill && stroke && std::fabs(state.fill_alpha - state.stroke_alpha) > 1e-12)
+            return false;
+        if (fill) apply_fill(); else if (stroke) apply_stroke();
+        QZContextDrawPath(ctx, mode);
+        return true;
+    }
+
+    bool execute(const std::string &op) {
+        double v[6];
+        if (op == "q") {
+            if (!operands.empty() || stack.size() >= 64) return false;
+            QZContextSaveGState(ctx); stack.push_back(state); return true;
+        }
+        if (op == "Q") {
+            if (!operands.empty() || stack.empty() || pending_clip) return false;
+            QZContextRestoreGState(ctx); state = stack.back(); stack.pop_back(); return true;
+        }
+        if (op == "cm") {
+            if (!numbers(6, v)) return false;
+            QZContextConcatCTM(ctx, QZAffineTransformMake(v[0], v[1], v[2], v[3], v[4], v[5]));
+            return true;
+        }
+        if (op == "m") { if (!numbers(2, v)) return false; QZContextMoveToPoint(ctx,v[0],v[1]); return true; }
+        if (op == "l") { if (!numbers(2, v)) return false; QZContextAddLineToPoint(ctx,v[0],v[1]); return true; }
+        if (op == "c") { if (!numbers(6, v)) return false; QZContextAddCurveToPoint(ctx,v[0],v[1],v[2],v[3],v[4],v[5]); return true; }
+        if (op == "v") {
+            /* First control point is the current point; CQuartz has no current
+             * point getter, so this less-common shorthand stays fail-closed. */
+            return false;
+        }
+        if (op == "y") return false;
+        if (op == "re") { if (!numbers(4,v)) return false; QZContextAddRect(ctx,QZRectMake(v[0],v[1],v[2],v[3])); return true; }
+        if (op == "h") { if (!operands.empty()) return false; QZContextClosePath(ctx); return true; }
+        if (op == "W" || op == "W*") {
+            /* Replacing a realized soft mask after changing the ordinary clip
+             * would require replaying that path into the retained clip plane.
+             * The measured corpus never combines those operations; reject the
+             * ambiguous boundary instead of losing the later clip. */
+            if (!operands.empty() || pending_clip ||
+                !state.soft_mask_base_clip.empty()) return false;
+            pending_clip = op == "W" ? 1 : 2; return true;
+        }
+        if (op == "n") {
+            if (!operands.empty()) return false;
+            if (pending_clip == 1) QZContextClip(ctx);
+            else if (pending_clip == 2) QZContextEOClip(ctx);
+            else QZContextBeginPath(ctx);
+            pending_clip = 0; return true;
+        }
+        if (op == "f" || op == "F") return operands.empty() && paint(kQZPathFill, false);
+        if (op == "f*") return operands.empty() && paint(kQZPathEOFill, false);
+        if (op == "S") return operands.empty() && paint(kQZPathStroke, false);
+        if (op == "s") return operands.empty() && paint(kQZPathStroke, true);
+        if (op == "B") return operands.empty() && paint(kQZPathFillStroke, false);
+        if (op == "B*") return operands.empty() && paint(kQZPathEOFillStroke, false);
+        if (op == "b") return operands.empty() && paint(kQZPathFillStroke, true);
+        if (op == "b*") return operands.empty() && paint(kQZPathEOFillStroke, true);
+        if (op == "w") { if (!numbers(1,v) || v[0] < 0) return false; QZContextSetLineWidth(ctx,v[0]); return true; }
+        if (op == "J") { if (!numbers(1,v) || v[0] < 0 || v[0] > 2 || v[0] != floor(v[0])) return false; QZContextSetLineCap(ctx,(QZLineCap)(int)v[0]); return true; }
+        if (op == "j") { if (!numbers(1,v) || v[0] < 0 || v[0] > 2 || v[0] != floor(v[0])) return false; QZContextSetLineJoin(ctx,(QZLineJoin)(int)v[0]); return true; }
+        if (op == "M") { if (!numbers(1,v) || v[0] < 1) return false; QZContextSetMiterLimit(ctx,v[0]); return true; }
+        if (op == "i") { if (!numbers(1,v) || v[0] < 0) return false; QZContextSetFlatness(ctx,v[0]); return true; }
+        if (op == "d") {
+            if (operands.size() != 2 || operands[0].kind != PDFOperand::NumberArray ||
+                operands[1].kind != PDFOperand::Number) return false;
+            std::vector<QZFloat> dash;
+            for (double n : operands[0].numbers) { if (n < 0) return false; dash.push_back(n); }
+            QZContextSetLineDash(ctx, operands[1].number, dash.data(), dash.size()); return true;
+        }
+        if (op == "rg" || op == "RG") {
+            if (!numbers(3,v)) return false;
+            PDFPaintState &s = state;
+            double *c = op == "rg" ? s.fill : s.stroke;
+            for (int i=0;i<3;i++) c[i]=clampd(v[i],0,1);
+            if (op == "rg") { s.fill_space=PDFColorSpace::RGB; apply_fill(); }
+            else { s.stroke_space=PDFColorSpace::RGB; apply_stroke(); }
+            return true;
+        }
+        if (op == "g" || op == "G") {
+            if (!numbers(1,v)) return false;
+            if (op == "g") { state.fill_space=PDFColorSpace::Gray; state.fill[0]=clampd(v[0],0,1); apply_fill(); }
+            else { state.stroke_space=PDFColorSpace::Gray; state.stroke[0]=clampd(v[0],0,1); apply_stroke(); }
+            return true;
+        }
+        if (op == "cs" || op == "CS") {
+            std::string name; PDFColorSpace space;
+            if (!one_name(&name) || !resolve_color_space(name,&space)) return false;
+            if (op == "cs") { state.fill_space=space; state.fill_pattern.clear(); }
+            else { state.stroke_space=space; state.stroke_pattern.clear(); }
+            return true;
+        }
+        if (op == "sc" || op == "scn") return set_color(true, op == "scn");
+        if (op == "SC" || op == "SCN") return set_color(false, op == "SCN");
+        if (op == "gs") { std::string name; return one_name(&name) && set_ext_gstate(name); }
+        if (op == "Do") { std::string name; return one_name(&name) && draw_xobject(name); }
+        if (op == "BDC" || op == "BMC" || op == "EMC" || op == "MP" || op == "DP")
+            return true; /* accessibility/layer metadata only */
+        return false;
+    }
+
+    friend class PDFReplay;
+};
+
+static bool draw_pdf_page_checked(QZContextRef ctx, QZPDFPageRef page) {
+    if (!ctx || !page || !page->owner || !page->owner->file) return false;
+    PDFFile *file = page->owner->file;
+    const PDFValue *resources = pdf_resources_for_owner(file, page->resources_owner);
+    if (!resources) return false;
     QZContextSaveGState(ctx);
     QZContextClipToRect(ctx, page->box);
     QZContextSetRGBFillColor(ctx, 0, 0, 0, 1);
     QZContextSetRGBStrokeColor(ctx, 0, 0, 0, 1);
     QZContextSetLineWidth(ctx, 1);
+    QZContextSetAlpha(ctx, 1);
     QZContextBeginPath(ctx);
-    replay_content(ctx, page->content);
+    PDFReplay replay(file, ctx, resources);
+    bool ok = true;
+    for (int object_number : page->content_objects) {
+        const std::vector<uint8_t> *content = nullptr;
+        if (!pdf_decode_stream(file, object_number, kPDFMaxContentStream, 0, &content) ||
+            !replay.run(*content)) { ok = false; break; }
+    }
+    if (!replay.balanced()) ok = false;
     QZContextRestoreGState(ctx);
+    return ok;
+}
+
+void QZContextDrawPDFPage(QZContextRef ctx, QZPDFPageRef page) {
+    (void)draw_pdf_page_checked(ctx, page);
+}
+
+uint8_t *QZPDFPageRasterizeRGBA(QZPDFPageRef page, QZFloat scale,
+                                int *out_width, int *out_height) {
+    if (out_width) *out_width = 0;
+    if (out_height) *out_height = 0;
+    if (!page || !std::isfinite(scale) || scale < 0.125 || scale > 8 ||
+        page->box.size.width <= 0 || page->box.size.height <= 0) return nullptr;
+    double wd = std::ceil(page->box.size.width * scale - 1e-9);
+    double hd = std::ceil(page->box.size.height * scale - 1e-9);
+    if (wd < 1 || hd < 1 || wd > 16384 || hd > 16384 ||
+        wd * hd > (double)(kPDFMaxDecodedStream / 4)) return nullptr;
+    int width = (int)wd, height = (int)hd;
+    QZContextRef ctx = QZBitmapContextCreate(nullptr, (size_t)width, (size_t)height,
+                                             8, (size_t)width * 4,
+                                             kQZImageAlphaPremultipliedLast);
+    if (!ctx) return nullptr;
+    QZContextScaleCTM(ctx, scale, scale);
+    QZContextTranslateCTM(ctx, -page->box.origin.x, -page->box.origin.y);
+    bool ok = draw_pdf_page_checked(ctx, page);
+    const uint8_t *source = (const uint8_t *)QZBitmapContextGetData(ctx);
+    size_t count = (size_t)width * (size_t)height;
+    uint8_t *result = ok ? (uint8_t *)malloc(count * 4) : nullptr;
+    if (result) {
+        for (size_t i = 0; i < count; i++) {
+            uint8_t alpha = source[i * 4 + 3];
+            result[i * 4 + 3] = alpha;
+            if (alpha == 0) {
+                result[i * 4 + 0] = result[i * 4 + 1] = result[i * 4 + 2] = 0;
+            } else if (alpha == 255) {
+                result[i * 4 + 0] = source[i * 4 + 0];
+                result[i * 4 + 1] = source[i * 4 + 1];
+                result[i * 4 + 2] = source[i * 4 + 2];
+            } else {
+                for (int c = 0; c < 3; c++)
+                    result[i * 4 + c] = clamp8((source[i * 4 + c] * 255 + alpha / 2) / alpha);
+            }
+        }
+    }
+    QZContextRelease(ctx);
+    if (!result) return nullptr;
+    if (out_width) *out_width = width;
+    if (out_height) *out_height = height;
+    return result;
 }
