+    PDFValue hex_string() {
+        PDFValue v;
+        if (p >= limit || s[p++] != '<') return v;
+        v.kind = PDFValue::String;
+        int high = -1;
+        while (p < limit && s[p] != '>') {
+            unsigned char c = (unsigned char)s[p++];
+            if (pdf_white(c)) continue;
+            if (!std::isxdigit(c)) return PDFValue{};
+            int n = std::isdigit(c) ? c - '0' : 10 + std::tolower(c) - 'a';
