+            else { v.text.push_back((char)((high << 4) | n)); high = -1; }
+        }
+        if (p >= limit || s[p++] != '>') return PDFValue{};
+        if (high >= 0) v.text.push_back((char)(high << 4));
+        return v;
+    }
+
+    PDFValue array_value(int depth) {
+        PDFValue v;
+        if (p >= limit || s[p++] != '[') return v;
+        v.kind = PDFValue::Array;
+        while (v.array.size() <= 65536) {
+            skip();
+            if (p < limit && s[p] == ']') { p++; return v; }
+            PDFValue item = value(depth);
+            if (item.kind == PDFValue::Invalid) return PDFValue{};
+            v.array.push_back(std::move(item));
+        }
+        return PDFValue{};
+    }
+
+    PDFValue dictionary_value(int depth) {
+        PDFValue v;
+        if (p + 1 >= limit || s[p] != '<' || s[p + 1] != '<') return v;
+        p += 2;
+        v.kind = PDFValue::Dictionary;
+        while (v.dictionary.size() <= 65536) {
+            skip();
+            if (p + 1 < limit && s[p] == '>' && s[p + 1] == '>') {
+                p += 2;
+                return v;
+            }
+            PDFValue key = name_value();
+            if (key.kind != PDFValue::Name) return PDFValue{};
+            for (const auto &existing : v.dictionary)
+                if (existing.first == key.text) return PDFValue{};
+            PDFValue item = value(depth);
+            if (item.kind == PDFValue::Invalid) return PDFValue{};
+            v.dictionary.emplace_back(std::move(key.text), std::move(item));
+        }
+        return PDFValue{};
+    }
+};
