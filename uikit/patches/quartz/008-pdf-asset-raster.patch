+
+static const PDFValue *pdf_resolve(const PDFFile *file, const PDFValue *value,
+                                   int depth = 0) {
+    if (!file || !value || depth > 32) return nullptr;
+    if (value->kind != PDFValue::Ref) return value;
+    auto it = file->objects.find(value->reference);
+    if (it == file->objects.end()) return nullptr;
+    return pdf_resolve(file, &it->second.value, depth + 1);
+}
+
+static bool pdf_number(const PDFFile *file, const PDFValue *value, double *out) {
+    value = pdf_resolve(file, value);
+    if (!value || value->kind != PDFValue::Number || !std::isfinite(value->number)) return false;
+    *out = value->number;
+    return true;
+}
+
+static bool pdf_int(const PDFFile *file, const PDFValue *value, int *out) {
+    double n = 0;
+    if (!pdf_number(file, value, &n) || n != std::floor(n) ||
+        n < std::numeric_limits<int>::min() || n > std::numeric_limits<int>::max())
+        return false;
+    *out = (int)n;
+    return true;
+}
 
