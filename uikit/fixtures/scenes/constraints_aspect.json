{
  "name": "constraints_aspect",
  "size": [320, 240],
  "scale": 2,
  "root": {
    "class": "UIView",
    "backgroundColor": "systemBackground",
    "subviews": [
      { "class": "UIView", "useConstraints": true, "backgroundColor": "systemBlue" },
      { "class": "UIView", "useConstraints": true, "backgroundColor": "systemOrange" },
      { "class": "UIView", "useConstraints": true, "backgroundColor": "systemGreen" }
    ]
  },
  "constraints": [
    { "item": "0", "attribute": "leading", "toItem": "", "constant": 16 },
    { "item": "0", "attribute": "top",     "toItem": "", "constant": 16 },
    { "item": "0", "attribute": "width",   "toItem": "", "toAttribute": "width",  "multiplier": 0.5 },
    { "item": "0", "attribute": "height",  "toItem": "0", "toAttribute": "width", "multiplier": 0.625 },

    { "item": "1", "attribute": "trailing", "toItem": "", "constant": -16 },
    { "item": "1", "attribute": "bottom",   "toItem": "", "constant": -16 },
    { "item": "1", "attribute": "height",   "toItem": "", "toAttribute": "height", "multiplier": 0.25 },
    { "item": "1", "attribute": "width",    "toItem": "1", "toAttribute": "height", "multiplier": 2 },

    { "item": "2", "attribute": "leading", "toItem": "", "constant": 16 },
    { "item": "2", "attribute": "bottom",  "toItem": "", "constant": -16 },
    { "item": "2", "attribute": "width",   "toItem": "", "toAttribute": "width", "multiplier": 0.3333 },
    { "item": "2", "attribute": "height",  "toItem": null, "constant": 30 }
  ]
}
