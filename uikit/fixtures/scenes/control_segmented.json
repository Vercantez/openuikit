{
  "name": "control_segmented",
  "size": [320, 200],
  "scale": 2,
  "style": "light",
  "window": true,
  "root": {
    "class": "UIView",
    "subviews": [
      { "class": "UIView", "frame": [0, 0, 320, 200], "backgroundColor": "#FFFFFF" },
      { "class": "UISegmentedControl", "frame": [20, 20, 280, 32],
        "segments": ["One", "Two", "Three"], "selectedSegmentIndex": 1 },
      { "class": "UISegmentedControl", "frame": [20, 70, 280, 32],
        "segments": ["Day", "Week"], "selectedSegmentIndex": 0 },
      { "class": "UISegmentedControl", "frame": [20, 120, 200, 32],
        "segments": ["All", "Unread", "Flagged", "Sent"], "selectedSegmentIndex": 3 },
      { "class": "UISegmentedControl", "frame": [20, 160, 200, 40],
        "segments": ["Left", "Right"], "selectedSegmentIndex": 1 }
    ]
  }
}
