{
  "name": "constraints_center_size",
  "size": [320, 240],
  "scale": 2,
  "root": {
    "class": "UIView",
    "backgroundColor": "systemBackground",
    "subviews": [
      { "class": "UIView", "useConstraints": true, "backgroundColor": "systemIndigo", "cornerRadius": 12 },
      { "class": "UIView", "useConstraints": true, "backgroundColor": "systemPink" },
      { "class": "UIView", "useConstraints": true, "backgroundColor": "systemTeal" }
    ]
  },
  "constraints": [
    { "item": "0", "attribute": "centerX", "toItem": "" },
    { "item": "0", "attribute": "centerY", "toItem": "" },
    { "item": "0", "attribute": "width",   "toItem": null, "constant": 120 },
    { "item": "0", "attribute": "height",  "toItem": null, "constant": 80 },

    { "item": "1", "attribute": "centerX", "toItem": "", "constant": 80 },
    { "item": "1", "attribute": "centerY", "toItem": "", "constant": -60 },
    { "item": "1", "attribute": "width",   "toItem": null, "constant": 40 },
    { "item": "1", "attribute": "height",  "toItem": null, "constant": 40 },

    { "item": "2", "attribute": "centerX", "toItem": "", "constant": -90 },
    { "item": "2", "attribute": "centerY", "toItem": "" },
    { "item": "2", "attribute": "width",   "toItem": null, "constant": 45 },
    { "item": "2", "attribute": "height",  "toItem": null, "constant": 25 }
  ]
}
