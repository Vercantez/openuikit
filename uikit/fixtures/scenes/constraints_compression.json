{
  "name": "constraints_compression",
  "size": [320, 100],
  "scale": 2,
  "root": {
    "class": "UIView",
    "backgroundColor": "systemBackground",
    "subviews": [
      { "class": "UILabel", "useConstraints": true, "text": "Resists compression firmly", "fontSize": 15,
        "backgroundColor": "systemYellow", "compressionH": 750 },
      { "class": "UILabel", "useConstraints": true, "text": "gives way and truncates", "fontSize": 15,
        "backgroundColor": "systemGreen", "compressionH": 749 },
      { "class": "UILabel", "useConstraints": true, "text": "squeezed on the left side", "fontSize": 15,
        "backgroundColor": "systemTeal", "compressionH": 749 },
      { "class": "UILabel", "useConstraints": true, "text": "holds its full intrinsic width", "fontSize": 15,
        "backgroundColor": "systemPink", "compressionH": 750 }
    ]
  },
  "constraints": [
    { "item": "0", "attribute": "leading",  "toItem": "", "constant": 12 },
    { "item": "1", "attribute": "leading",  "toItem": "0", "toAttribute": "trailing", "constant": 8 },
    { "item": "1", "attribute": "trailing", "relation": "le", "toItem": "", "constant": -12 },
    { "item": "1", "attribute": "width", "relation": "le", "toItem": null, "constant": 110 },
    { "item": "0", "attribute": "centerY",  "toItem": "", "multiplier": 0.5 },
    { "item": "1", "attribute": "centerY",  "toItem": "", "multiplier": 0.5 },

    { "item": "2", "attribute": "leading",  "toItem": "", "constant": 12 },
    { "item": "3", "attribute": "leading",  "toItem": "2", "toAttribute": "trailing", "constant": 8 },
    { "item": "3", "attribute": "trailing", "toItem": "", "constant": -12 },
    { "item": "2", "attribute": "centerY",  "toItem": "", "multiplier": 1.5 },
    { "item": "3", "attribute": "centerY",  "toItem": "", "multiplier": 1.5 }
  ]
}
