<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>confprobe</string>
	<key>CFBundleIdentifier</key><string>com.openuikit.confprobe</string>
	<key>CFBundleName</key><string>ConfProbe</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>CFBundleSupportedPlatforms</key>
	<array><string>iPhoneSimulator</string></array>
	<key>MinimumOSVersion</key><string>26.0</string>
	<key>UIDeviceFamily</key><array><integer>1</integer></array>
	<!-- Modern (non-letterboxed) layout without a storyboard. -->
	<key>UILaunchScreen</key><dict/>
	<!-- Same status-bar hide as the portrait SE plist: the dump's
	     screen.windowSafeArea is the measurement (brief expected
	     [0, 0, 21, 0] in landscapeLeft). -->
	<key>UIStatusBarHidden</key><true/>
	<key>UIViewControllerBasedStatusBarAppearance</key><false/>
	<!-- Landscape-only so the process launches into landscapeLeft even
	     if the Simulator window is still portrait. Portrait ConfProbe
	     stays all-but-upside-down (no orientations key). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationLandscapeLeft</string>
	</array>
	<!-- Legacy (non-scene) lifecycle: no UIApplicationSceneManifest. -->
</dict>
</plist>
