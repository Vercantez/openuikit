<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>simscene</string>
	<key>CFBundleIdentifier</key><string>com.openuikit.simscene</string>
	<key>CFBundleName</key><string>SimScene</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>1.0</string>
	<key>CFBundleVersion</key><string>1</string>
	<key>CFBundleSupportedPlatforms</key>
	<array><string>iPhoneSimulator</string></array>
	<key>MinimumOSVersion</key><string>26.0</string>
	<!-- Family 1+2: native iPad layout, not the iPhone-compatibility
	     375×667 letterbox. Same as ConfProbe-iPad-Info.plist. -->
	<key>UIDeviceFamily</key><array><integer>1</integer><integer>2</integer></array>
	<!-- Modern (non-letterboxed) layout without a storyboard. -->
	<key>UILaunchScreen</key><dict/>
	<!-- Status bar stays visible so the window safe area is the iPad (A16)
	     measurement `[32, 0, 25, 0]`. The phone SimScene-Info.plist is
	     family-1 only (iPhone 16 / SE). -->
	<!-- Legacy (non-scene) lifecycle: no UIApplicationSceneManifest. -->
</dict>
</plist>
