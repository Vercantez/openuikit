# objc-config.h: Linux feature flags -- no shared cache, no preopt caches, pthreads threading, 48-bit-safe cache mask
--- a/runtime/objc-config.h
+++ b/runtime/objc-config.h
@@ -55,7 +55,13 @@
 #endif
 
 // Define SUPPORT_PREOPT=1 to enable dyld shared cache optimizations
+#if TARGET_OS_LINUX
+    // objc4-linux: there is no dyld shared cache. objc-opt.mm already carries
+    // a complete `#if !SUPPORT_PREOPT` fallback body for every entry point.
+#   define SUPPORT_PREOPT 0
+#else
 #   define SUPPORT_PREOPT 1
+#endif
 
 // Define SUPPORT_TAGGED_POINTERS=1 to enable tagged pointer objects
 // Be sure to edit tagged pointer SPI in objc-internal.h as well.
@@ -216,7 +222,10 @@
 #define CACHE_MASK_STORAGE_HIGH_16_BIG_ADDRS 4
 
 #if defined(__arm64__) && __LP64__
-#if   TARGET_OS_OSX || TARGET_OS_SIMULATOR
+#if   TARGET_OS_OSX || TARGET_OS_SIMULATOR || TARGET_OS_LINUX
+// objc4-linux: aarch64 Linux user VA is 48- or 52-bit (a kernel config), so
+// the 36-bit-safe CACHE_MASK_STORAGE_HIGH_16 variant used on embedded Darwin
+// would truncate bucket pointers. Use the big-address variant.
 #define CACHE_MASK_STORAGE CACHE_MASK_STORAGE_HIGH_16_BIG_ADDRS
 #else
 #define CACHE_MASK_STORAGE CACHE_MASK_STORAGE_HIGH_16
@@ -293,7 +302,12 @@
 // Be sure to edit the equivalent define in objc-internal.h as well.
 // Be sure to not enable CONFIG_USE_PREOPT_CACHES if CACHE_MASK_STORAGE != CACHE_MASK_STORAGE_HIGH_16
 #ifndef CONFIG_USE_PREOPT_CACHES
-#if   TARGET_OS_OSX || TARGET_OS_MACCATALYST
+#if   TARGET_OS_LINUX
+// objc4-linux: preoptimized method caches are built into the dyld shared
+// cache. There is none, and SUPPORT_PREOPT is 0. Without this the
+// `defined(__arm64__) && __LP64__` arm below would turn them on.
+#define CONFIG_USE_PREOPT_CACHES 0
+#elif TARGET_OS_OSX || TARGET_OS_MACCATALYST
 #define CONFIG_USE_PREOPT_CACHES 0
 #define CONFIG_USE_PREOPT_CACHES_BUILD_ONLY 1
 #elif TARGET_OS_SIMULATOR
@@ -329,7 +343,8 @@
 #define HAVE_CLOCK_GETTIME_NSEC_NP 0
 #endif
 
-#if   TARGET_OS_MAC
+#if   TARGET_OS_MAC || TARGET_OS_LINUX
+// objc4-linux: glibc provides asprintf/vasprintf (_GNU_SOURCE).
 #define HAVE_ASPRINTF   1
 #else
 #define HAVE_ASPRINTF   0
@@ -343,6 +358,11 @@
 
 #if   TARGET_OS_MAC
 #   define OBJC_THREADING_PACKAGE OBJC_THREADING_DARWIN
+#elif TARGET_OS_LINUX
+    // objc4-linux: prefer pure pthreads over C11 threads. glibc has both, but
+    // the pthreads back-end is the one Apple wrote non-Darwin branches for,
+    // and fork-safety (pthread_atfork) has no C11 equivalent.
+#   define OBJC_THREADING_PACKAGE  OBJC_THREADING_PTHREADS
 #elif __has_include(<threads.h>)
 #   define OBJC_THREADING_PACKAGE  OBJC_THREADING_C11THREADS
 #elif __has_include(<pthread.h>)
