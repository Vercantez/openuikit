+
+static ALWAYS_INLINE
+bool
+StoreExclusive(uintptr_t *dst, uintptr_t *oldvalue, uintptr_t value)
+{
+    if (slowpath(__builtin_arm_strex(value, dst))) {
+        *oldvalue = LoadExclusive(dst);
+        return false;
+    }
