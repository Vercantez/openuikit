+/*======================================================================
+ * objc4-linux: OS compatibility, part 2.
+ *====================================================================*/
+
+// objc4 has 43 `#if __arm64__` sites, and __arm64__ is an Apple-only
+// predefine: on Linux/aarch64 every one of them would silently take the
+// x86-64/generic branch, selecting a different cache_t layout than the
+// assembly messenger uses. The build defines it; this asserts the build did.
+#if defined(__aarch64__) && !defined(__arm64__)
+#   error "objc4-linux: -D__arm64__=1 is missing. See docs/PORT_MAP.md 2.7."
+#endif
+
+// Mach-O load command constants: named by code that is compiled out.
+#ifndef __LP64__
+#   define SEGMENT_CMD LC_SEGMENT
+#else
+#   define SEGMENT_CMD LC_SEGMENT_64
+#endif
+
+#ifndef VM_MEMORY_OBJC_DISPATCHERS
+#   define VM_MEMORY_OBJC_DISPATCHERS 0
+#endif
+
+
+// Compiler compatibility
+
+// OS compatibility
+
+static inline uint64_t nanoseconds() {
+    // Darwin uses CLOCK_MONOTONIC_RAW (unslewed). Linux has the same clock id
+    // with the same meaning.
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC_RAW, &ts);
+    return uint64_t(1000000000) * ts.tv_sec + ts.tv_nsec;
+}
+
+// Threading
+#include "Threading/threading.h"
+
+// Old names for locks
+using spinlock_t = objc_lock_t;
+using mutex_t = objc_lock_t;
+using recursive_mutex_t = objc_recursive_lock_t;
+
+using mutex_locker_t = mutex_t::locker;
+using conditional_mutex_locker_t = mutex_t::conditional_locker;
+
+// Image identity. `headerType` is objc4's opaque per-image cookie; on ELF it
+// is a record libobjc allocates itself (compat/mach-o/loader.h). Keeping the
+// Darwin spelling means the ~37 call sites and the <objc/objc-internal.h> SPI
+// signatures that Swift's runtime calls are untouched.
+typedef struct mach_header_64 headerType;
+typedef struct segment_command_64 segmentType;
+typedef struct section_64 sectionType;
+#define headerIsBundle(hi) (hi->mhdr()->filetype == MH_BUNDLE)
+#define libobjc_header ((headerType *)&_mh_dylib_header)
+extern "C" struct mach_header_64 _mh_dylib_header;
+
+// The single image-discovery seam (PORT_MAP 3.3). Identical shape to the
+// Darwin version; _dyld_lookup_section_info is ours and answers from a
+// per-image table built by walking ELF section headers.
+template<typename T>
+static T* getSectionData(const headerType* mhdr,
+                         _dyld_section_location_info_t info,
+                         _dyld_section_location_kind kind,
+                         size_t *outCount)
+{
+    _dyld_section_info_result result = _dyld_lookup_section_info((const struct mach_header *)mhdr, info, kind);
+    if ( result.buffer != NULL ) {
+        *outCount = result.bufferSize / sizeof(T);
+        return (T*)result.buffer;
+    }
+
+    *outCount = 0;
+    return NULL;
+}
