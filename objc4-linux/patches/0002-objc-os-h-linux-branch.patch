-#ifndef __BUILDING_OBJCDT__
+#if !defined(__BUILDING_OBJCDT__) && !TARGET_OS_LINUX
 // fork() safety requires careful tracking of all locks.
 // Our custom lock types check this in debug builds.
 // Disallow direct use of all other lock types.
+//
+// objc4-linux: not done here. On Darwin pthread_mutex_t is a typedef of
+// __darwin_pthread_mutex_t, so it can be shadowed by an unavailable alias
+// without breaking <pthread.h>. In glibc pthread_mutex_t is a union type in
+// its own right, and Apple's OBJC_THREADING_PTHREADS back-end
+// (runtime/Threading/pthreads.h) uses it directly -- shadowing it would make
+// the threading package itself unavailable. The fork-safety lock audit is
+// therefore NOT enforced by the type system on Linux.
 typedef __darwin_pthread_mutex_t pthread_mutex_t UNAVAILABLE_ATTRIBUTE;
 typedef __darwin_pthread_rwlock_t pthread_rwlock_t UNAVAILABLE_ATTRIBUTE;
 typedef struct os_unfair_lock_s os_unfair_lock UNAVAILABLE_ATTRIBUTE;
