# objc-internal.h + NSObject.mm: ELF symbol spelling for the three __asm__-labelled ARC entry points, and weak-undefined swift_retain/swift_release
--- a/runtime/objc-internal.h
+++ b/runtime/objc-internal.h
@@ -1113,19 +1113,34 @@
 objc_sync_try_enter(id _Nonnull obj)
     OBJC_AVAILABLE(10.15, 13.0, 13.0, 6.0, 5.0);
 
+/*
+ * objc4-linux: these three are declared with an explicit assembler label so
+ * that the C name and the symbol name can differ. The label is spelled in
+ * MACH-O convention (one leading underscore for a C symbol); on ELF that same
+ * spelling names a *different* symbol, and libobjc.so fails to load with
+ *   undefined symbol: _objc_release
+ * because the definitions emit `objc_release` while every caller that saw
+ * this header emits `_objc_release`.
+ */
+#if TARGET_OS_LINUX
+#   define OBJC4LINUX_ASM_LABEL(macho, elf) __asm__(elf)
+#else
+#   define OBJC4LINUX_ASM_LABEL(macho, elf) __asm__(macho)
+#endif
+
 OBJC_EXPORT id _Nullable
 objc_retain(id _Nullable obj)
-    __asm__("_objc_retain")
+    OBJC4LINUX_ASM_LABEL("_objc_retain", "objc_retain")
     OBJC_AVAILABLE(10.7, 5.0, 9.0, 1.0, 2.0);
 
 OBJC_EXPORT void
 objc_release(id _Nullable obj)
-    __asm__("_objc_release")
+    OBJC4LINUX_ASM_LABEL("_objc_release", "objc_release")
     OBJC_AVAILABLE(10.7, 5.0, 9.0, 1.0, 2.0);
 
 OBJC_EXPORT id _Nullable
 objc_autorelease(id _Nullable obj)
-    __asm__("_objc_autorelease")
+    OBJC4LINUX_ASM_LABEL("_objc_autorelease", "objc_autorelease")
     OBJC_AVAILABLE(10.7, 5.0, 9.0, 1.0, 2.0);
 
 // Prepare a value at +1 for return through a +0 autoreleasing convention.
--- a/runtime/NSObject.mm
+++ b/runtime/NSObject.mm
@@ -110,11 +110,37 @@
 PtrauthGlobalAtomicFunction<id(*)(id)> swiftRetain{&_initializeSwiftRefcountingThenCallRetain};
 PtrauthGlobalAtomicFunction<void(*)(id)> swiftRelease{&_initializeSwiftRefcountingThenCallRelease};
 
+#if TARGET_OS_LINUX
+/*
+ * objc4-linux: Darwin gets "refer to libswiftCore without forcing it to load"
+ * from the linker's -delay_init. ELF's equivalent is a WEAK UNDEFINED symbol:
+ * if libswiftCore is in the process the reference resolves to it, and if it
+ * is not, the reference is NULL and no load is forced.
+ *
+ * Without this, libobjc.so does not even dlopen:
+ *   undefined symbol: swift_retain
+ *
+ * The NULL case is reachable only for an object whose class isSwiftStable(),
+ * which cannot exist unless libswiftCore is loaded -- so if we ever see it,
+ * something is badly wrong and we say so rather than jumping to 0.
+ */
+extern "C" id swift_retain(id) __attribute__((weak));
+extern "C" void swift_release(id) __attribute__((weak));
+#else
 extern "C" id swift_retain(id);
 extern "C" void swift_release(id);
+#endif
 
 ALWAYS_INLINE
 static void _initializeSwiftRefcounting() {
+#if TARGET_OS_LINUX
+    if (!swift_retain || !swift_release) {
+        _objc_fatal("objc4-linux: a Swift object reached swiftRetain/swiftRelease "
+                    "but libswiftCore is not loaded (swift_retain=%p "
+                    "swift_release=%p). See docs/UNIMPLEMENTED.md.",
+                    (void *)swift_retain, (void *)swift_release);
+    }
+#endif
     swiftRetain.store(swift_retain, memory_order_relaxed);
     ASSERT(swiftRetain.load(memory_order_relaxed));
     swiftRelease.store(swift_release, memory_order_relaxed);
