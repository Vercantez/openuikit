# isa.h + objc-object.h: select the 52-bit shiftcls_and_sig isa layout, which is the ONLY one objc4 accepts for an arm64 macOS target.
#
# THIS IS NOT A LINUX PATCH, despite what it used to say here. The old header
# claimed "the host address space is 48 bits wide (MEASURED), so use the wide
# isa", and that is not the reason -- this hunk would be needed on a 39-bit
# kernel too. The reason is that objc4 rejects the alternative at COMPILE TIME:
#
#   objc-runtime-new.mm:260: error: '_static_assert' declared as an array with
#                            a negative size
#   STATIC_ASSERT((~ISA_MASK & OBJC_VM_MAX_ADDRESS) == 0 ||
#                 ISA_MASK + sizeof(void*) == OBJC_VM_MAX_ADDRESS)
#
# Without the patch, plain __arm64__ takes isa.h's #else branch: a 33-bit
# shiftcls with ISA_MASK 0x0000000ffffffff8, whose own comment says
# /*MACH_VM_MAX_ADDRESS 0x1000000000*/ -- a 64 GiB ceiling. That is the iOS
# DEVICE layout, and it is incompatible with the 128 TiB OBJC_VM_MAX_ADDRESS a
# macOS target gets, hence the assert.
#
# So this patch does not make our objc4 diverge from Apple's shipping runtime;
# it makes it MATCH. Apple never ships plain-arm64-non-e on macOS: real macOS
# arm64 libobjc is arm64e, which takes the very same
# __has_feature(ptrauth_calls) branch this patch selects, minus the signing.
# The measured VA width is why the layout WORKS for us, not why it is required.
#
# WHAT USED TO BE HERE AND IS NOW GONE: a third hunk widening FAST_DATA_MASK to
# 0x0f00fffffffffff8 and DEBUG_DATA_MASK to 0x0000fffffffffff8, because
# class_rw_t pointers are heap addresses and the heap used to sit above 2^47.
# The loader now confines both images and the heap below 2^47, so stock
# 0x0f007ffffffffff8 / 0x00007ffffffffff8 hold, and DEBUG_DATA_MASK is once
# again bit-identical to Apple's. That deleted hunk was the one with zero
# headroom (docs/UNIMPLEMENTED.md#isa-va-width); it is gone rather than better
# documented.
diff -ru a/runtime/isa.h b/runtime/isa.h
--- a/runtime/isa.h	2026-08-25 22:19:53.245149193 -0500
+++ b/runtime/isa.h	2026-08-25 22:19:53.245991152 -0500
@@ -57,7 +57,18 @@
 # if __arm64__
 // ARM64 simulators have a larger address space, so use the ARM64e
 // scheme even when simulators build for ARM64-not-e.
-#   if   __has_feature(ptrauth_calls) || TARGET_OS_SIMULATOR
+// machorun: the host is Linux/aarch64, whose user addresses are 48 bits
+// wide (MEASURED in the test container: malloc returns 0xffffb132f010,
+// bit 47 set). The 33-bit `shiftcls` below assumes MACH_VM_MAX_ADDRESS
+// 0x1000000000 and would silently truncate every class pointer. The
+// 52-bit `shiftcls_and_sig` field covers it. This is the SAME layout
+// Apple's shipping arm64e libobjc uses; we take it without the signing,
+// because __has_feature(ptrauth_calls) is false for plain arm64.
+//
+// Without this, objc-runtime-new.mm's own STATIC_ASSERT fires:
+//   (~ISA_MASK & OBJC_VM_MAX_ADDRESS) == 0 || ISA_MASK + 8 == OBJC_VM_MAX_ADDRESS
+// with OBJC_VM_MAX_ADDRESS = MACH_VM_MAX_ADDRESS = 0x00007FFFFE000000.
+#   if   __has_feature(ptrauth_calls) || TARGET_OS_SIMULATOR || OBJC_MACHORUN
 #     define ISA_MASK        0x007ffffffffffff8ULL
 #     define ISA_MAGIC_MASK  0x0000000000000001ULL
 #     define ISA_MAGIC_VALUE 0x0000000000000001ULL
@@ -96,7 +107,7 @@
 #     define RC_HALF              (1ULL<<18)
 #   endif
 
-#   if TARGET_OS_SIMULATOR
+#   if TARGET_OS_SIMULATOR || OBJC_MACHORUN
 #     define ISA_MASK_NOSIG ISA_MASK
 #   elif TARGET_OS_OSX
 #     define ISA_MASK_NOSIG 0x00007ffffffffff8ULL
diff -ru a/runtime/objc-object.h b/runtime/objc-object.h
--- a/runtime/objc-object.h	2026-08-25 22:19:53.245433152 -0500
+++ b/runtime/objc-object.h	2026-08-25 22:19:53.246079944 -0500
@@ -180,7 +180,10 @@
 #endif
 
     // Match the conditional in isa.h.
-#if __has_feature(ptrauth_calls) || TARGET_OS_SIMULATOR
+    // machorun: OBJC_MACHORUN selects the same 52-bit shiftcls_and_sig
+    // layout as arm64e/simulator, so this must match. Apple's own comment
+    // above is the instruction; this is obeying it.
+#if __has_feature(ptrauth_calls) || TARGET_OS_SIMULATOR || OBJC_MACHORUN
 #   if ISA_SIGNING_SIGN_MODE == ISA_SIGNING_SIGN_NONE
     // No signing, just use the raw pointer.
     uintptr_t signedCls = (uintptr_t)newCls;
