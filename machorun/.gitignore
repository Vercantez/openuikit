build/
out/
*.o
*.so
.DS_Store

# Test output. tests/expected/ is the oracle and IS committed; tests/actual/
# is regenerated by every harness run and is not.
tests/actual/

# Linux-built x86_64 guests and the in-VM scoreboard capture. tests/bin/ is
# the Apple-toolchain reference corpus and stays committed; these are not.
tests/bin-x86_64/
tests/actual-x86_64/

# Our Mach-O dylibs are build products, not sources.
darwin/usr/
build/sdk-src/

# The .tbd stubs are generated FROM darwin/usr/lib/*.dylib by scripts/gen_tbd.sh
# and are only ever as true as the last build. sdk/usr/include IS committed --
# it is assembled from redistributable sources and must work with no network.
sdk/usr/lib/

# scripts/stress_unfair_lock.sh's scratch capture, written next to the fixtures
# it runs so the loop does not need a temp dir. Regenerated every run.
tests/objc44/.stress.stderr
tests/bin/.stress.stderr
