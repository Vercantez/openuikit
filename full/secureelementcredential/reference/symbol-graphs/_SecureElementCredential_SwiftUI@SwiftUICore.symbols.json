{"metadata":{"formatVersion":{"major":0,"minor":6,"patch":0},"generator":"Apple Swift version 6.2.1 (swiftlang-6.2.1.4.8 clang-1700.4.4.1)"},"module":{"name":"SecureElementCredential","bystanders":["SwiftUI"],"platform":{"architecture":"aarch64","vendor":"apple","operatingSystem":{"name":"ios","minimumVersion":{"major":26,"minor":1}}}},"symbols":[{"kind":{"identifier":"swift.method","displayName":"Instance Method"},"identifier":{"precise":"s:7SwiftUI4ViewP025_SecureElementCredential_aB0E15transactionTask_6actionQrAD0F11TransactionC13ConfigurationCSg_yAHYactF","interfaceLanguage":"swift"},"pathComponents":["View","transactionTask(_:action:)"],"names":{"title":"transactionTask(_:action:)","subHeading":[{"kind":"keyword","spelling":"func"},{"kind":"text","spelling":" "},{"kind":"identifier","spelling":"transactionTask"},{"kind":"text","spelling":"("},{"kind":"typeIdentifier","spelling":"CredentialTransaction","preciseIdentifier":"s:32_SecureElementCredential_SwiftUI0C11TransactionC"},{"kind":"text","spelling":"."},{"kind":"typeIdentifier","spelling":"Configuration","preciseIdentifier":"s:32_SecureElementCredential_SwiftUI0C11TransactionC13ConfigurationC"},{"kind":"text","spelling":"?, "},{"kind":"externalParam","spelling":"action"},{"kind":"text","spelling":": ("},{"kind":"typeIdentifier","spelling":"CredentialTransaction","preciseIdentifier":"s:32_SecureElementCredential_SwiftUI0C11TransactionC"},{"kind":"text","spelling":") "},{"kind":"keyword","spelling":"async"},{"kind":"text","spelling":" -> "},{"kind":"typeIdentifier","spelling":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","spelling":") -> "},{"kind":"keyword","spelling":"some"},{"kind":"text","spelling":" "},{"kind":"typeIdentifier","spelling":"View","preciseIdentifier":"s:7SwiftUI4ViewP"},{"kind":"text","spelling":"\n"}]},"docComment":{"module":"_SecureElementCredential_SwiftUI","lines":[{"text":"Provides a task to perform before this view appears"},{"text":""},{"text":" This task provides an instance of a"},{"text":"``CredentialTransaction`` to be used to perform transactions."},{"text":""},{"text":"A typical client should use the APIs in the following sequence:"},{"text":"1. ``acquirePresentmentIntentAssertion()`` prior to showing any proprietary payment UI"},{"text":"2. ``relinquish()`` the assertion before invoking the transaction API"},{"text":"3. ``configuration.invalidate()`` after presenting the credential"},{"text":"4. Optionally, ``acquirePresentmentIntentAssertion()`` to finish up any proprietary payment UI"},{"text":"5. ``relinquish()`` the assertion"},{"text":""},{"text":"For example:"},{"text":""},{"text":"     struct TransactionView: View {"},{"text":"         @State private var configuration: CredentialTransaction.Configuration?"},{"text":"         private var assertion: PresentmentIntentAssertion // acquirePresentmentIntentAssertion() before transitioning into this view (step 1)"},{"text":"         private var activeSession: CredentialSession"},{"text":"         private var selectedCredential: Credential"},{"text":""},{"text":"         var body: some View {"},{"text":"             VStack {"},{"text":"                 Button(\"Perform Transaction\") {"},{"text":"                     guard let configuration else {"},{"text":"                        configuration = activeSession.configuration()"},{"text":"                        return"},{"text":"                     }"},{"text":""},{"text":"                     configuration.invalidate() // step 3"},{"text":"                     // Optional"},{"text":"                     assertion = try await session.acquirePresentmentIntentAssertion() // step 4"},{"text":"                     // handle any proprietary UI"},{"text":"                     try await assertion.relinquish() // step 5"},{"text":"                     // Optional end"},{"text":"                 }"},{"text":"                 .transactionTask(configuration) { transaction in"},{"text":"                     do {"},{"text":"                         try await assertion.relinquish() // step 2"},{"text":"                         try await transaction.performTransaction(using: selectedCredential)"},{"text":"                     } catch {"},{"text":"                         // code to handle error"},{"text":"                     }"},{"text":"                 }"},{"text":"             }"},{"text":"         }"},{"text":"     }"},{"text":""},{"text":"- Parameters:"},{"text":"    - configuration: A configuration containing information about the transaction task."},{"text":"        When the task is completed or an error is encountered while performing the task,"},{"text":"        the system invalidates this configuration, and the ``CredentialTransaction`` is invalidated."},{"text":"    - action: A closure that will be called when `isPerformingTransaction` is `true`."},{"text":"        It provides a ``CredentialTransaction`` instance that can be used to perform transactions."},{"text":""}]},"functionSignature":{"parameters":[{"name":"configuration","declarationFragments":[{"kind":"identifier","spelling":"configuration"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"CredentialTransaction","preciseIdentifier":"s:32_SecureElementCredential_SwiftUI0C11TransactionC"},{"kind":"text","spelling":"."},{"kind":"typeIdentifier","spelling":"Configuration","preciseIdentifier":"s:32_SecureElementCredential_SwiftUI0C11TransactionC13ConfigurationC"},{"kind":"text","spelling":"?"}]},{"name":"action","declarationFragments":[{"kind":"identifier","spelling":"action"},{"kind":"text","spelling":": ("},{"kind":"typeIdentifier","spelling":"CredentialTransaction","preciseIdentifier":"s:32_SecureElementCredential_SwiftUI0C11TransactionC"},{"kind":"text","spelling":") "},{"kind":"keyword","spelling":"async"},{"kind":"text","spelling":" -> "},{"kind":"typeIdentifier","spelling":"Void","preciseIdentifier":"s:s4Voida"}]}],"returns":[{"kind":"keyword","spelling":"some"},{"kind":"text","spelling":" "},{"kind":"typeIdentifier","spelling":"View","preciseIdentifier":"s:7SwiftUI4ViewP"}]},"swiftExtension":{"extendedModule":"SwiftUICore","typeKind":"swift.protocol"},"declarationFragments":[{"kind":"attribute","spelling":"nonisolated"},{"kind":"text","spelling":" "},{"kind":"keyword","spelling":"func"},{"kind":"text","spelling":" "},{"kind":"identifier","spelling":"transactionTask"},{"kind":"text","spelling":"("},{"kind":"externalParam","spelling":"_"},{"kind":"text","spelling":" "},{"kind":"internalParam","spelling":"configuration"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"CredentialTransaction","preciseIdentifier":"s:32_SecureElementCredential_SwiftUI0C11TransactionC"},{"kind":"text","spelling":"."},{"kind":"typeIdentifier","spelling":"Configuration","preciseIdentifier":"s:32_SecureElementCredential_SwiftUI0C11TransactionC13ConfigurationC"},{"kind":"text","spelling":"?, "},{"kind":"externalParam","spelling":"action"},{"kind":"text","spelling":": "},{"kind":"attribute","spelling":"@escaping "},{"kind":"text","spelling":"("},{"kind":"typeIdentifier","spelling":"CredentialTransaction","preciseIdentifier":"s:32_SecureElementCredential_SwiftUI0C11TransactionC"},{"kind":"text","spelling":") "},{"kind":"keyword","spelling":"async"},{"kind":"text","spelling":" -> "},{"kind":"typeIdentifier","spelling":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","spelling":") -> "},{"kind":"keyword","spelling":"some"},{"kind":"text","spelling":" "},{"kind":"typeIdentifier","spelling":"View","preciseIdentifier":"s:7SwiftUI4ViewP"},{"kind":"text","spelling":"\n"}],"accessLevel":"public","availability":[{"domain":"macOS","isUnconditionallyUnavailable":true},{"domain":"watchOS","isUnconditionallyUnavailable":true},{"domain":"iOS","introduced":{"major":18,"minor":1}},{"domain":"visionOS","isUnconditionallyUnavailable":true},{"domain":"tvOS","isUnconditionallyUnavailable":true}]}],"relationships":[{"kind":"memberOf","source":"s:7SwiftUI4ViewP025_SecureElementCredential_aB0E15trans