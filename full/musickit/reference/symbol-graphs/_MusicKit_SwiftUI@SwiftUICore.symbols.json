{"metadata":{"formatVersion":{"major":0,"minor":6,"patch":0},"generator":"Apple Swift version 6.2.1 (swiftlang-6.2.1.4.8 clang-1700.4.4.1)"},"module":{"name":"MusicKit","bystanders":["SwiftUI"],"platform":{"architecture":"aarch64","vendor":"apple","operatingSystem":{"name":"ios","minimumVersion":{"major":26,"minor":1}}}},"symbols":[{"kind":{"identifier":"swift.method","displayName":"Instance Method"},"identifier":{"precise":"s:7SwiftUI4ViewP010_MusicKit_aB0E22musicSubscriptionOffer11isPresented7options16onLoadCompletionQrAA7BindingVySbG_AD0dgH0V7OptionsVys5Error_pSgctF","interfaceLanguage":"swift"},"pathComponents":["View","musicSubscriptionOffer(isPresented:options:onLoadCompletion:)"],"names":{"title":"musicSubscriptionOffer(isPresented:options:onLoadCompletion:)","subHeading":[{"kind":"keyword","spelling":"func"},{"kind":"text","spelling":" "},{"kind":"identifier","spelling":"musicSubscriptionOffer"},{"kind":"text","spelling":"("},{"kind":"externalParam","spelling":"isPresented"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"Binding","preciseIdentifier":"s:7SwiftUI7BindingV"},{"kind":"text","spelling":"<"},{"kind":"typeIdentifier","spelling":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","spelling":">, "},{"kind":"externalParam","spelling":"options"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"MusicSubscriptionOffer","preciseIdentifier":"s:17_MusicKit_SwiftUI0A17SubscriptionOfferV"},{"kind":"text","spelling":"."},{"kind":"typeIdentifier","spelling":"Options","preciseIdentifier":"s:17_MusicKit_SwiftUI0A17SubscriptionOfferV7OptionsV"},{"kind":"text","spelling":", "},{"kind":"externalParam","spelling":"onLoadCompletion"},{"kind":"text","spelling":": ((any "},{"kind":"typeIdentifier","spelling":"Error","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","spelling":")?) -> "},{"kind":"typeIdentifier","spelling":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","spelling":") -> "},{"kind":"keyword","spelling":"some"},{"kind":"text","spelling":" "},{"kind":"typeIdentifier","spelling":"View","preciseIdentifier":"s:7SwiftUI4ViewP"},{"kind":"text","spelling":"\n"}]},"docComment":{"module":"_MusicKit_SwiftUI","lines":[{"text":"Initiates the process of presenting a sheet with subscription offers"},{"text":"for Apple Music when the `isPresented` binding is `true`."},{"text":""},{"text":"The example below displays a simple button that the user can activate"},{"text":"to begin presenting subscription offers for Apple Music. The action"},{"text":"handler of this button initiates the presentation of those offers"},{"text":"by setting the `isShowingOffer` variable to `true`."},{"text":""},{"text":"    struct MusicSubscriptionOfferButton: View {"},{"text":"        @State var isShowingOffer = false"},{"text":"        var body: some View {"},{"text":"            Button(\"Apple Music Subscription Offer\") {"},{"text":"                isShowingOffer = true"},{"text":"            }"},{"text":"            .musicSubscriptionOffer(isPresented: $isShowingOffer)"},{"text":"        }"},{"text":"    }"},{"text":""},{"text":"You can also configure the Apple Music subscription offer by"},{"text":"creating an instance of `MusicSubscriptionOffer.Options`, setting"},{"text":"relevant properties on it, and passing it to "},{"text":"`.musicSubscriptionOffer(…)`."},{"text":"For example, to present contextual offers that highlight a specific"},{"text":"album, you can configure the subscription offer like the following:"},{"text":""},{"text":"    struct MusicSubscriptionOfferButton: View {"},{"text":"        var album: Album"},{"text":"        @State var isShowingOffer = false"},{"text":"        @State var offerOptions = MusicSubscriptionOffer.Options("},{"text":"            affiliateToken: \"<affiliate_token>\", "},{"text":"            campaignToken: \"<campaign_token>\""},{"text":"        )"},{"text":""},{"text":"        var body: some View {"},{"text":"            Button(\"Apple Music Subscription Offer\") {"},{"text":"                offerOptions.itemID = album.id"},{"text":"                isShowingOffer = true"},{"text":"            }"},{"text":"            .musicSubscriptionOffer("},{"text":"                isPresented: $isShowingOffer, "},{"text":"                options: offerOptions"},{"text":"            )"},{"text":"        }"},{"text":"    }"},{"text":""},{"text":"The initial value of `offerOptions` includes relevant tokens"},{"text":"(affiliate and campaign tokens) that allow you to receive compensation"},{"text":"for referring new Apple Music subscribers. For more information,"},{"text":"see this presentation of the"},{"text":"[Apple Services Performance Partners Program](https://affiliate.itunes.apple.com/resources/)."},{"text":""},{"text":"You may also set `isShowingOffer` to `false` to programmatically"},{"text":"dismiss the subscription offer (or to abort its loading process)."},{"text":""},{"text":"- Parameters:"},{"text":"  - isPresented: A binding to a Boolean value that you can set to"},{"text":"    `true` to show a sheet with subscription offers for Apple Music."},{"text":"  - options: Options to use for loading the subscription offer for"},{"text":"    Apple Music."},{"text":"  - onLoadCompletion: The function to call upon completing the initial"},{"text":"    loading process for this subscription offer. The subscription"},{"text":"    offer UI becomes visible when it calls this function with the"},{"text":"    error argument as `nil`. If there is an error in the"},{"text":"    loading process, the subscription offer calls this function with"},{"text":"    a non-`nil` error, and it resets the `isPresented` binding"},{"text":"    to `false`."}]},"functionSignature":{"parameters":[{"name":"isPresented","declarationFragments":[{"kind":"identifier","spelling":"isPresented"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"Binding","preciseIdentifier":"s:7SwiftUI7BindingV"},{"kind":"text","spelling":"<"},{"kind":"typeIdentifier","spe