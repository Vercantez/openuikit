thkit/HKObjectType> class"},{"text":"  (any of the <doc://com.apple.documentation/documentation/healthkit/HKCharacteristicType>,"},{"text":"  <doc://com.apple.documentation/documentation/healthkit/HKQuantityType>,"},{"text":"  <doc://com.apple.documentation/documentation/healthkit/HKCategoryType>,"},{"text":"  <doc://com.apple.documentation/documentation/healthkit/HKWorkoutType>, or"},{"text":"  <doc://com.apple.documentation/documentation/healthkit/HKCorrelationType>"},{"text":"   classes )."},{"text":"  If the user grants permission, your app can read these data types from the HealthKit store."},{"text":""},{"text":"  - trigger: A value used to trigger the request. This value must be a"},{"text":"  <doc://com.apple.documentation/documentation/swiftui/State> variable."},{"text":"   Any change to the variable triggers a request."},{"text":""},{"text":"  - completion: A block that the system calls after the request is complete. The system passes the result parameter."},{"text":""},{"text":"  - result: A  value that indicates whether the request succeeded."},{"text":"      This value doesn't indicate whether the user actually granted permission."},{"text":"      The value is `.success` if the request succeeded; otherwise, it's `.error`."},{"text":"      You can access the error's description from the `.error` value."},{"text":""},{"text":"HealthKit performs these requests asynchronously when you modify the trigger's value."},{"text":"If you call this method with a new data type (a type of data that the user hasn't previously granted or"},{"text":"denied permission for in this app), the system automatically displays the authorization sheet"},{"text":"when you modify the trigger's value. The authorization sheet lists all the requested permissions."},{"text":"After the user finishes responding, HealthKit calls the completion block on a background queue."},{"text":"If the user has already chosen to grant or prohibit access to all of the types specified,"},{"text":"HealthKit calls the completion when you modify the trigger without prompting the user."},{"text":""},{"text":"Each data type has two separate permissions, one to read it and one to share it."},{"text":"You can make a single request, and include all the data types your app needs."},{"text":""},{"text":"@TabNavigator {"},{"text":"    @Tab(\"Authenticating on launch\") {"},{"text":"        ```swift"},{"text":"        @State private var trigger = false"},{"text":""},{"text":"        var body: some Scene {"},{"text":"            WindowGroup {"},{"text":"                ContentView(enabled: $authenticated)"},{"text":"                    .healthDataAccessRequest(store: store,"},{"text":"                                             shareTypes: healthDataTypes,"},{"text":"                                             readTypes: healthDataTypes,"},{"text":"                                             trigger: trigger) { result in"},{"text":"                        switch result {"},{"text":""},{"text":"                        case .success(_):"},{"text":"                            authenticated = true"},{"text":"                        case .failure(let error):"},{"text":"                            // Handle the error here."},{"text":"                            fatalError(\"*** An error occurred while requesting authentication: \\(error) ***\")"},{"text":"                        }"},{"text":""},{"text":"                        logger.debug(\"Authentication Complete.\")"},{"text":"                    }"},{"text":"                    .onAppear() {"},{"text":"                        trigger.toggle()"},{"text":"                    }"},{"text":"            }"},{"text":"        }"},{"text":"        ```"},{"text":"    }"},{"text":"    @Tab(\"Full Swift file\") {"},{"text":"        ```swift"},{"text":"        import SwiftUI"},{"text":"        import HealthKit"},{"text":"        import HealthKitUI"},{"text":"        import os"},{"text":""},{"text":"        let healthDataTypes: Set = ["},{"text":"            HKQuantityType.workoutType(),"},{"text":"            HKQuantityType(.heartRate),"},{"text":"            HKQuantityType(.activeEnergyBurned),"},{"text":"            HKQuantityType(.basalEnergyBurned),"},{"text":"            HKQuantityType(.distanceWalkingRunning),"},{"text":"            HKQuantityType(.stepCount)"},{"text":"        ]"},{"text":""},{"text":"        private let logger = Logger(subsystem: \"example.com.MyWorkoutApp\","},{"text":"                                    category: \"iOS App\")"},{"text":""},{"text":"        @main"},{"text":"        struct MyApp: App {"},{"text":""},{"text":"            @State private var authenticated = false"},{"text":"            @State private var trigger = false"},{"text":""},{"text":"            let store = HKHealthStore()"},{"text":""},{"text":"            var body: some Scene {"},{"text":"                WindowGroup {"},{"text":"                    ContentView(enabled: $authenticated)"},{"text":"                        .healthDataAccessRequest(store: store,"},{"text":"                                                 shareTypes: healthDataTypes,"},{"text":"                                                 readTypes: healthDataTypes,"},{"text":"                                                 trigger: trigger) { result in"},{"text":"                            switch result {"},{"text":""},{"text":"                            case .success(_):"},{"text":"                                authenticated = true"},{"text":"                            case .failure(let error):"},{"text":"                                // Handle the error here."},{"text":"                                fatalError(\"*** An error occurred while requesting authentication: \\(error) ***\")"},{"text":"                            }"},{"text":""},{"text":"                            logger.debug(\"Authentication Complete.\")"},{"text":"                        }"},{"text":"                        .onAppear() {"},{"text":"                            trigger.toggle()"},{"text":"                        }"},{"text":"                }"},{"text":"            }"},{"text":"        }"},{"text":"        ```"},{"text":"    }"},{"text":"}"},{"text":""},{"text":"Customize the messages displayed on the permissions sheet by setting the following keys:"},{"text":""},{"text":"- <doc://com.apple.documentation/documentation/bundleresources/information_property_list/NSHealthShareUsageDescription>"},{"text":"customizes the message for reading data."},{"text":""},{"text":"- <doc://com.apple.documentation/documentation/bundleresources/information_property_list/NSHealthUpdateUsageDescription>"},{"text":"customizes the message for writing data."},{"text":""},{"text":"> Warning: You must set the usage keys, or your app crashes when you request authorization."},{"text":""},{"text":"Set these keys in the Target Properties list on the app's Info tab."},{"text":""},{"text":"After users set the permissions for your app, they can always change them using either the"},{"text":"Settings or the Health app. Your app appears in the Health app's Sources tab,"},{"text":"even if the user didn't allow permission to read or share data."},{"text":""}]},"functionSignature":{"parameters":[{"name":"store","declarationFragments":[{"kind":"identifier","spelling":"store"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"HKHealthStore","preciseIdentifier":"c:objc(cs)HKHealthStore"}]},{"name":"shareTypes","declarationFragments":[{"kind":"identifier","spelling":"shareTypes"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","spelling":"<"},{"kind":"typeIdentifier","spelling":"HKSampleType","preciseIdentifier":"c:objc(cs)HKSampleType"},{"kind":"text","spelling":">"}]},{"name":"readTypes","declarationFragments":[{"kind":"identifier","spelling":"readTypes"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"Set","preciseIdentifier":"s:Sh"},{"kind