 "},{"kind":"externalParam","spelling":"predicate"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"NSPredicate","preciseIdentifier":"c:objc(cs)NSPredicate"},{"kind":"text","spelling":"?, "},{"kind":"externalParam","spelling":"trigger"},{"kind":"text","spelling":": "},{"kind":"keyword","spelling":"some"},{"kind":"text","spelling":" "},{"kind":"typeIdentifier","spelling":"Equatable","preciseIdentifier":"s:SQ"},{"kind":"text","spelling":", "},{"kind":"externalParam","spelling":"completion"},{"kind":"text","spelling":": ("},{"kind":"typeIdentifier","spelling":"Result","preciseIdentifier":"s:s6ResultO"},{"kind":"text","spelling":"<"},{"kind":"typeIdentifier","spelling":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","spelling":", any "},{"kind":"typeIdentifier","spelling":"Error","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","spelling":">) -> "},{"kind":"typeIdentifier","spelling":"Void","preciseIdentifier":"s:s4Voida"},{"kind":"text","spelling":") -> "},{"kind":"keyword","spelling":"some"},{"kind":"text","spelling":" "},{"kind":"typeIdentifier","spelling":"View","preciseIdentifier":"s:7SwiftUI4ViewP"},{"kind":"text","spelling":"\n"}]},"docComment":{"module":"HealthKitUI","lines":[{"text":"Asynchronously requests permission to read a data type that requires per-object authorization (such as vision prescriptions)."},{"text":""},{"text":"- Parameters:"},{"text":"  - store: The HealthKit store where you're requesting authorization."},{"text":""},{"text":"  - objectType: The data type you want to read. This type must be a type that requires per-object authorization."},{"text":""},{"text":"  - predicate: An optional predicate that further restricts the objects of interest."},{"text":""},{"text":"  - trigger: A value used to trigger the request. This value must be a"},{"text":"  <doc://com.apple.documentation/documentation/swiftui/State> variable."},{"text":"   Any change to the variable triggers a request."},{"text":""},{"text":"  - completion: A block that the system calls after the request is complete. The system passes the result parameter."},{"text":""},{"text":"  - result: A  value that indicates whether the request succeeded."},{"text":"      This value doesn't indicate whether the user actually granted permission."},{"text":"      The value is `.success` if the request succeeded; otherwise, it's `.error`."},{"text":"      You can access the error's description from the `.error` value."},{"text":""},{"text":"Some samples require per-object authorization."},{"text":"For these samples, people can select which ones your app can read on a sample-by-sample basis."},{"text":"By default, your app can read any of the per-object authorization samples that it has saved to the HealthKit store;"},{"text":"however, you may not always have access to those samples. People can update the authorization status for any of these samples at any time."},{"text":""},{"text":"Your app can begin by setting up the request in SwiftUI."},{"text":""},{"text":"```swift"},{"text":"@State private var trigger = false"},{"text":"let store = HKHealthStore()"},{"text":""},{"text":"var body: some Scene {"},{"text":"    WindowGroup {"},{"text":"        ContentView(enabled: $authenticated)"},{"text":"            .healthDataAccessRequest(store: store,"},{"text":"                                     objectType: .visionPrescriptionType(),"},{"text":"                                     predicate: nil,"},{"text":"                                     trigger: trigger) { result in"},{"text":""},{"text":"                switch result {"},{"text":"                case .success(_):"},{"text":"                    authenticated = true"},{"text":"                case .failure(let error):"},{"text":"                    // Handle the error here."},{"text":"                    fatalError(\"*** An error occurred while requesting authentication: \\(error) ***\")"},{"text":"                }"},{"text":""},{"text":"                logger.debug(\"Authentication Complete.\")"},{"text":"            }"},{"text":"    }"},{"text":"}"},{"text":"```"},{"text":""},{"text":"Next, query for any samples that it already has permission to read."},{"text":""},{"text":"```swift"},{"text":"// Read the newest prescription from the HealthKit store."},{"text":"let queryDescriptor = HKSampleQueryDescriptor(predicates: [.visionPrescription()],"},{"text":"                                              sortDescriptors: [SortDescriptor(\\.startDate, order: .reverse)],"},{"text":"                                              limit: 1)"},{"text":""},{"text":"let prescription: HKVisionPrescription"},{"text":""},{"text":"do {"},{"text":"    guard let result = try await queryDescriptor.result(for: store).first else {"},{"text":"        print(\"*** No prescription found. ***\")"},{"text":"        return"},{"text":"    }"},{"text":""},{"text":"    prescription = result"},{"text":"} catch {"},{"text":"    // Handle the error here."},{"text":"    fatalError(\"*** An error occurred while reading the most recent vision prescriptions: \\(error.localizedDescription) ***\")"},{"text":"}"},{"text":"```"},{"text":""},{"text":"Based on the results, you can then decide whether you need to request authorization for additional samples."},{"text":"Modify the trigger's value to prompt someone to modify the samples your app has access to read."},{"text":""},{"text":"```swift"},{"text":"// Request authorization for additional samples."},{"text":"trigger.toggle()"},{"text":"```"},{"text":""},{"text":"> Important: Using the <doc://com.apple.documentation/documentation/swiftui/view/healthDataAccessRequest(store:shareTypes:readTypes:trigger:completion:)>"},{"text":"  method to request read access to any data types"},{"text":"  that require per-object authorization fails with an"},{"text":"  <doc://com.apple.documentation/documentation/healthkit/hkerror/2320686-errorinvalidargument> error."},{"text":""},{"text":"When your app calls this method, HealthKit displays an authorization sheet"},{"text":"that asks for permission to read the samples that match the predicate and object type."},{"text":"The person using your app can then select individual samples to share with your app."},{"text":"The system always asks for permission, regardless of whether the user previously granted it."},{"text":""},{"text":"People can individually enable each of the prescriptions."},{"text":"After they respond, the system calls the callback handler on an arbitrary background queue."},{"text":""}]},"functionSignature":{"parameters":[{"name":"store","declarationFragments":[{"kind":"identifier","spelling":"store"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"HKHealthStore","preciseIdentifier":"c:objc(cs)HKHealthStore"}]},{"name":"objectType","declarationFragments":[{"kind":"identifier","spelling":"objectType"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"HKObjectType","preciseIdentifier":"c:objc(cs)HKObjectType"}]},{"name":"predicate","declarationFragments":[{"kind":"identifier","spelling":"predicate"},{"kind":"text","spelling":": "},{"kind":"typeIdentifier","spelling":"NSPredicate","preciseIdentifier":"c:objc(cs)NSPredicate"},{"kind":"text","spelling":"?"}]},{"name":"trigger","declarationFragments":[{"kind":"identifier","spelling":"trigger"},{"kind":"text","spelling":": "},{"kind":"keyword","spelling":"some"},{"kind":"text","spelling":" "},{"kind":"typeIdentifier","spelling":"Equatable","preciseIdentifier":"s:SQ"}]},{"name":"completion","declarationFragments":[{"kind":"identifier","spelling":"completion"},{"kind":"text","spelling":": ("},{"kind":"typeIdentifier","spelling":"Result","preciseIdentifier":"s:s6ResultO"},{"kind":"text","spelling":"<"},{"kind":"typeIdentifier","spelling":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","spelling":", any "},{"kind":"typeIdentifier","spelling":"Error","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","spelling":">) -> "},{"kind":"typeIdentifier","spelling":"Void","preciseI