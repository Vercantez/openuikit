+#if TARGET_OS_LINUX
+/*
+ * objc4-linux: ELF has no __LD,__compact_unwind. The equivalent is DWARF CFI
+ * in .eh_frame, and it is NOT optional: without it, an Objective-C or C++
+ * exception thrown through objc_msgSend cannot unwind and
+ * _Unwind_RaiseException calls std::terminate().
+ *
+ * CFI_START/CFI_END bracket every ENTRY/END_ENTRY pair. For the `NoFrame`
+ * functions -- objc_msgSend, objc_msgLookup, objc_msgSendSuper2 and friends,
+ * which never move SP and never spill LR -- the default rule (CFA = SP+0,
+ * return address in x30) is exactly right, so .cfi_startproc alone is
+ * correct and complete.
+ *
+ * It is NOT complete for the functions that go through SAVE_REGS: those
+ * subtract from SP and spill x0-x8/q0-q7/fp/lr, and this macro emits no
+ * .cfi_def_cfa_offset / .cfi_offset for them. Unwinding from inside
+ * _objc_msgSend_uncached or _method_invoke will therefore compute a wrong
+ * CFA. See docs/UNIMPLEMENTED.md.
+ */
+#define CFI_START .cfi_startproc
+#define CFI_END   .cfi_endproc
+#else
+#define CFI_START
+#define CFI_END
+#endif
+
 /********************************************************************
  * ENTRY functionName
  * STATIC_ENTRY functionName
  * END_ENTRY functionName
  ********************************************************************/
 
-.macro ENTRY /* name */
+.macro ENTRY name
 	.text
 	.align 5
-	.globl    $0
-$0:
+	.globl    \name
+\name:
+	CFI_START
 .endmacro
 
-.macro MSG_ENTRY /*name*/
+.macro MSG_ENTRY name
 	.text
 	.align 10
-	.globl    $0
-$0:
+	.globl    \name
+\name:
+	CFI_START
 .endmacro
 
-.macro STATIC_ENTRY /*name*/
+.macro STATIC_ENTRY name
 	.text
 	.align 5
-	.private_extern $0
-$0:
+	.private_extern \name
+\name:
+	CFI_START
 .endmacro
 
-.macro END_ENTRY /* name */
-LExit$0:
+.macro END_ENTRY name
+	CFI_END
+LExit\name:
 .endmacro
 
 
