# objc-exception.mm + objc-cache.mm: ELF/GAS dialect for the two hand-written inline-asm data blocks (typeinfo vtable, empty cache)
--- a/runtime/objc-exception.mm
+++ b/runtime/objc-exception.mm
@@ -164,6 +164,63 @@
 // Hand-built vtable for objc exception typeinfo.
 // "OLD" is GNU libcpp, "NEW" is libc++abi.
 
+#if TARGET_OS_LINUX
+/*
+ * objc4-linux: the same table, in ELF/GAS dialect. Mechanical differences:
+ *   .cstring                  -> .section .rodata.str1.1,"aMS",@progbits,1
+ *   .section __DATA,__const   -> .section .data.rel.ro,"aw",@progbits
+ *                                (relocated at load, then read-only)
+ *   l_.id_str                 -> .L.objc_id_str   (ELF local-label prefix)
+ *   _foo (C symbol `foo`)     -> foo              (no leading underscore)
+ *   __objc_exception_noop     -> _objc_exception_noop
+ * plus .type/.size, which ELF tooling wants and Mach-O has no analogue for.
+ *
+ * The layout, the entry order and the libc++abi vtable contract are
+ * unchanged -- Linux uses the same Itanium C++ ABI libc++abi implements.
+ */
+asm(
+    "\n .section .rodata.str1.1,\"aMS\",@progbits,1"
+    "\n .L.objc_id_str: .asciz \"id\""
+
+    "\n .section .data.rel.ro,\"aw\",@progbits"
+    "\n .globl OBJC_EHTYPE_id"
+    "\n .globl objc_ehtype_vtable"
+    "\n .type  OBJC_EHTYPE_id,@object"
+    "\n .type  objc_ehtype_vtable,@object"
+    "\n .p2align 4"
+
+    "\n OBJC_EHTYPE_id:"
+    "\n  " PTR "(objc_ehtype_vtable+" TWOPTRSIZE ")"
+    "\n  " PTR ".L.objc_id_str"
+    "\n  " PTR "0"
+    "\n .size OBJC_EHTYPE_id, . - OBJC_EHTYPE_id"
+
+    "\n objc_ehtype_vtable:"
+    "\n  " PTR "0"
+    // typeinfo's typeinfo - fixme hack
+    "\n  " PTR "OBJC_EHTYPE_id"
+    // destructor and in-place destructor
+    "\n  " PTR "_objc_exception_noop"
+    "\n  " PTR "_objc_exception_noop"
+    // OLD __is_pointer_p
+    "\n  " PTR "_objc_exception_noop"
+    // OLD __is_function_p
+    "\n  " PTR "_objc_exception_noop"
+    // OLD __do_catch,  NEW can_catch
+    "\n  " PTR "_objc_exception_do_catch"
+    // OLD __do_upcast, NEW search_above_dst
+    "\n  " PTR "_objc_exception_false"
+    //                  NEW search_below_dst
+    "\n  " PTR "_objc_exception_false"
+    // NEW has_unambiguous_public_base (fixme need this?)
+    "\n  " PTR "_objc_exception_abort1"
+    // paranoia: die if libcxxabi adds anything else
+    "\n  " PTR "_objc_exception_abort2"
+    "\n  " PTR "_objc_exception_abort3"
+    "\n  " PTR "_objc_exception_abort4"
+    "\n .size objc_ehtype_vtable, . - objc_ehtype_vtable"
+    );
+#else
 asm(
     "\n .cstring"
     "\n l_.id_str: .asciz \"id\""
@@ -202,6 +259,7 @@
     "\n  " PTR "__objc_exception_abort3"
     "\n  " PTR "__objc_exception_abort4"
     );
+#endif // TARGET_OS_LINUX
 
 
 
--- a/runtime/objc-cache.mm
+++ b/runtime/objc-cache.mm
@@ -216,6 +216,31 @@
 
 // "cache" is cache->buckets; "vtable" is cache->mask/occupied
 // hack to avoid conflicts with compiler's internal declaration
+#if TARGET_OS_LINUX
+/*
+ * objc4-linux: same table, ELF/GAS dialect.
+ *   .section __TEXT,__const  -> .section .rodata,"a",@progbits
+ *   __objc_empty_cache       -> _objc_empty_cache   (no leading underscore)
+ *   .align 3 / L-prefixed local labels -> .p2align 3 / .L-prefixed
+ * `.set _objc_empty_vtable, 0` still produces an absolute symbol of value 0,
+ * which is what the C side expects (a class with no vtable).
+ */
+asm("\n .section .rodata,\"a\",@progbits"
+    "\n .globl _objc_empty_vtable"
+    "\n .set _objc_empty_vtable, 0"
+    "\n .globl _objc_empty_cache"
+    "\n .type  _objc_empty_cache,@object"
+#if CACHE_MASK_STORAGE == CACHE_MASK_STORAGE_LOW_4
+    "\n .p2align 4"
+    "\n .L_objc_empty_cache_base: .space " stringize2(EMPTY_BYTES)
+    "\n .set _objc_empty_cache, .L_objc_empty_cache_base + 0xf"
+#else
+    "\n .p2align 3"
+    "\n _objc_empty_cache: .space " stringize2(EMPTY_BYTES)
+    "\n .size _objc_empty_cache, " stringize2(EMPTY_BYTES)
+#endif
+    );
+#else
 asm("\n .section __TEXT,__const"
     "\n .globl __objc_empty_vtable"
     "\n .set __objc_empty_vtable, 0"
@@ -229,6 +254,7 @@
     "\n __objc_empty_cache: .space " stringize2(EMPTY_BYTES)
 #endif
     );
+#endif // TARGET_OS_LINUX
 
 #if CONFIG_USE_PREOPT_CACHES || CONFIG_USE_PREOPT_CACHES_BUILD_ONLY
 __attribute__((used, section("__DATA_CONST,__objc_scoffs")))
@@ -1141,6 +1167,31 @@
 
 static int _collecting_in_critical(void)
 {
+#if TARGET_OS_LINUX
+    /*
+     * objc4-linux: UNIMPLEMENTED -- method cache garbage is never freed.
+     *
+     * This function answers "is any thread currently executing inside the
+     * range of objc_msgSend that reads cache buckets?", so that freed buckets
+     * cannot be read after free. Darwin answers it two ways, and neither
+     * exists on Linux:
+     *   - task_restartable_ranges_synchronize() (HAVE_TASK_RESTARTABLE_RANGES,
+     *     forced to 0 here). rseq(2) is the semantic analogue but aborts
+     *     rather than restarts and needs a compiler-emitted critical section.
+     *   - task_threads() + thread_get_state() to read every thread's PC. The
+     *     Linux equivalent is enumerating /proc/self/task and signalling each
+     *     thread to sample uc_mcontext.pc; /proc/<pid>/stat field 30 reads 0
+     *     without CAP_SYS_ADMIN and is not usable.
+     *
+     * Returning TRUE is the CONSERVATIVE answer: "a reader may be active,
+     * do not free". The cost is that cache_collect() never reclaims, i.e.
+     * every cache reallocation LEAKS the old bucket array. This is a leak,
+     * not a feature. See docs/UNIMPLEMENTED.md.
+     *
+     * Note the polarity: returning FALSE here would be a use-after-free.
+     */
+    return TRUE;
+#else
 
 #if HAVE_TASK_RESTARTABLE_RANGES
     // Only use restartable ranges if we registered them earlier.
@@ -1231,6 +1282,7 @@
     // Return our finding
     return result;
 
+#endif // TARGET_OS_LINUX
 }
 
 
@@ -1338,8 +1390,15 @@
     } 
     else {
         // No excuses.
+#if TARGET_OS_LINUX
+        // objc4-linux: _collecting_in_critical() is hardwired TRUE above, so
+        // this spin would never terminate. Give up on collecting instead --
+        // the garbage leaks. See docs/UNIMPLEMENTED.md.
+        return;
+#else
         while (_collecting_in_critical()) 
             ;
+#endif
     }
 
     // No cache readers in progress - garbage is now deletable
