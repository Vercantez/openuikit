{
  "name": "constraints_nested",
  "size": [320, 200],
  "scale": 2,
  "root": {
    "class": "UIView",
    "backgroundColor": "systemBackground",
    "subviews": [
      { "class": "UIView", "useConstraints": true, "backgroundColor": "secondarySystemBackground",
        "cornerRadius": 10,
        "subviews": [
          { "class": "UIView", "useConstraints": true, "backgroundColor": "systemBlue" },
          { "class": "UIView", "useConstraints": true, "backgroundColor": "systemRed",
            "subviews": [
              { "class": "UIView", "useConstraints": true, "backgroundColor": "white", "cornerRadius": 6 }
            ] }
        ] },
      { "class": "UIView", "useConstraints": true, "backgroundColor": "systemGreen" }
    ]
  },
  "constraints": [
    { "item": "0", "attribute": "leading",  "toItem": "", "constant": 20 },
    { "item": "0", "attribute": "trailing", "toItem": "", "constant": -20 },
    { "item": "0", "attribute": "top",      "toItem": "", "constant": 20 },
    { "item": "0", "attribute": "height",   "toItem": null, "constant": 110 },

    { "item": "0.0", "attribute": "leading", "toItem": "0", "constant": 10 },
    { "item": "0.0", "attribute": "top",     "toItem": "0", "constant": 10 },
    { "item": "0.0", "attribute": "bottom",  "toItem": "0", "constant": -10 },
    { "item": "0.0", "attribute": "width",   "toItem": null, "constant": 60 },

    { "item": "0.1", "attribute": "leading",  "toItem": "0.0", "toAttribute": "trailing", "constant": 10 },
    { "item": "0.1", "attribute": "trailing", "toItem": "0", "constant": -10 },
    { "item": "0.1", "attribute": "top",      "toItem": "0", "constant": 10 },
    { "item": "0.1", "attribute": "bottom",   "toItem": "0", "constant": -10 },

    { "item": "0.1.0", "attribute": "centerX", "toItem": "0.1" },
    { "item": "0.1.0", "attribute": "centerY", "toItem": "0.1" },
    { "item": "0.1.0", "attribute": "width",  "toItem": null, "constant": 30 },
    { "item": "0.1.0", "attribute": "height", "toItem": null, "constant": 30 },

    { "item": "1", "attribute": "leading", "toItem": "", "constant": 20 },
    { "item": "1", "attribute": "top",     "toItem": "0", "toAttribute": "bottom", "constant": 12 },
    { "item": "1", "attribute": "width",   "toItem": null, "constant": 80 },
    { "item": "1", "attribute": "height",  "toItem": null, "constant": 30 }
  ]
}
