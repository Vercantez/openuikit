SUBCMDSHIFT             8
SUBCMDMASK              0xff
USRQUOTA                0
GRPQUOTA                1
Q_QUOTAON               0x100
Q_QUOTAOFF              0x200
Q_GETQUOTA              0x300
Q_SETQUOTA              0x400
Q_SYNC                  0x600
Q_QUOTASTAT             0x700
QCMD(Q_GETQUOTA,USR)    0x30000
sizeof struct dqblk     64
Q_QUOTASTAT on /        rc -1 errno 45 is ENOTSUP 1
Q_GETQUOTA on /         rc -1 errno 45 is ENOTSUP 1
Q_QUOTASTAT on /tmp     rc -1 errno 45 is ENOTSUP 1
Q_QUOTASTAT bad path    rc -1 errno 2 is ENOENT 1
caller falls back       1
done
